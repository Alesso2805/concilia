# Production settings for docker-compose.prod.yml (docs/DEPLOY.md). Copy to /opt/concilia/.env,
# chmod 600, and replace every value; generate secrets with `openssl rand -hex 32`.
SITE_ADDRESS=concilia.example.com
ACME_EMAIL=ops@example.com
CONCILIA_IMAGES=ghcr.io/owner-in-lowercase

POSTGRES_PASSWORD=
CONCILIA_OWNER_PASSWORD=
CONCILIA_APP_PASSWORD=
CONCILIA_WORKER_PASSWORD=
CONCILIA_BACKUP_PASSWORD=
CONCILIA_CSRF_SECRET=
CONCILIA_RATE_LIMIT_SECRET=

CONCILIA_AI_ENABLED=false
OPENAI_API_KEY=
CONCILIA_AI_GLOBAL_DAILY_LIMIT=200

BACKUP_KEEP_DAYS=14
