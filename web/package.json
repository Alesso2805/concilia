{
  "name": "concilia-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p e2e/tsconfig.json",
    "e2e": "playwright test",
    "generate:api": "ng-openapi-gen --config ng-openapi-gen.json",
    "e2e:video": "playwright test --config playwright.video.config.ts e2e/full-flow.spec.ts"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/roboto": "^5.3.0",
    "echarts": "6.1.0",
    "ngx-echarts": "22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@material-symbols/svg-400": "^0.49.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "angular-eslint": "22.7.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.0",
    "ng-openapi-gen": "1.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0"
  }
}
